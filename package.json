{
  "name": "roam-tools",
  "version": "1.0.0",
  "description": "Tools to transform Roam Research content for sharing",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun run scripts/dev.js",
    "serve": "bun run dev",
    "build": "bun build src/index.html --outdir dist --target browser --sourcemap --minify",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "keywords": [
    "roam",
    "markdown",
    "text-transform"
  ],
  "author": "Ryan Guill",
  "license": "ISC",
  "dependencies": {
    "jquery": "^3.7.1",
    "remarkable": "^2.0.1"
  }
}
